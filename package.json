{
  "name": "combined-reversi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node serve.cjs",
    "build:pages": "node scripts/build-pages.cjs",
    "test": "node --test nickname-policy.test.cjs engine.test.cjs ai.test.cjs app.test.cjs site.test.cjs presence.test.cjs backend/store.test.mjs",
    "online:dev": "wrangler dev --config backend/wrangler.jsonc --var RANKED_ENABLED:true --var ALLOWED_ORIGINS:http://127.0.0.1:4173,http://localhost:4173",
    "online:check": "wrangler deploy --dry-run --config backend/wrangler.jsonc --outdir .worker-build",
    "test:online": "npm run online:check && node --test backend/transport.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.167.0"
  }
}
