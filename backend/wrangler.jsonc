{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "1234-reversi-ranked",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "vars": {
    "RANKED_ENABLED": "true",
    "ALLOWED_ORIGINS": "https://1234reversi.com,https://www.1234reversi.com,https://ikempty.github.io"
  },
  "durable_objects": {
    "bindings": [{"name": "RANKED", "class_name": "RankedLobby"},{"name": "PRESENCE", "class_name": "PresenceLobby"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["RankedLobby"]},{"tag":"v2","new_sqlite_classes":["PresenceLobby"]}],
  "observability": {"enabled": false}
}
